# venv / 虚拟环境
.venv/
venv/
__pycache__/
*.py[cod]

# 打包产物
build/
dist/
*.spec
installer/output/

# spider 运行时（Python/CI 侧不重编译 Java，直接使用预构建 jar）
spider-runtime/build/
!spider-runtime/dist/
spider-runtime/dist/*
!spider-runtime/dist/spider-runtime.jar

# dex2jar 依赖库（约 20MB）：由 prepare_runtime.ps1 自动获取，
# 本地开发也可直接复用 toolchain/dex-tools-v2.4/lib
spider-runtime/dex2jar-lib/

# 本地配置
.local/
tvbox_win_settings.json
